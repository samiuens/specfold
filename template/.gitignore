# personal Specfold settings, such as actors.github_login for specfold verify
.specfold/local.yaml

# Claude Code worktrees
.claude/worktrees/

# sf-migrate progress, local to one migration run
.specfold/migration/state.json

# graphify code graph, rebuilt in every clone (specfold graphify setup)
graphify-out/

# personal Claude Code settings, such as the subagent limit (specfold parallel set)
.claude/settings.local.json

# index of this worktree for test ports (specfold wt setup)
.specfold/wt-index
